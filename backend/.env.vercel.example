# Configuración para despliegue en Vercel

# Habilitar despliegue en Vercel (opcional)
VERCEL_ENABLED=true

# Token de Vercel (obtén uno en https://vercel.com/account/tokens)
VERCEL_TOKEN=tu_token_de_vercel_aqui

# Team ID (opcional, si usas equipo en Vercel)
VERCEL_TEAM_ID=team_tu_team_id

# Configuración normal de MyCloud
PORT=3001
NODE_ENV=production

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mycloud_platform
DB_USER=postgres
DB_PASSWORD=tu_contraseña

# JWT
JWT_SECRET=tu_jwt_super_secreto_aqui
JWT_EXPIRES_IN=24h

# Paths
PROJECTS_BASE_PATH=./projects
UPLOADS_PATH=./uploads
LOGS_PATH=./logs

# Port pool
PORT_RANGE_START=4000
PORT_RANGE_END=5000

# Upload limits
MAX_FILE_SIZE_MB=200

# Health check
HEALTH_CHECK_RETRIES=10
HEALTH_CHECK_INTERVAL_MS=3000
HEALTH_CHECK_TIMEOUT_MS=30000

# Process startup wait
PROCESS_START_WAIT_MS=5000
