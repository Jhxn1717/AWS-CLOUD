# Ejemplo para el backend persistente que procesa ZIP y llama a Vercel.
# No alojar este worker como una función serverless: necesita disco temporal y procesos.

VERCEL_ENABLED=true
VERCEL_TOKEN=tu_token_de_vercel_aqui
VERCEL_TEAM_ID=

PORT=3001
NODE_ENV=production

DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/mycloud_platform
DB_SSL=true
DB_POOL_MAX=5
CORS_ORIGINS=https://tu-frontend.vercel.app

JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
JWT_EXPIRES_IN=24h
ADMIN_NAME=MyCloud Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_DE_12_CARACTERES_O_MAS

# Paths
PROJECTS_BASE_PATH=./projects
UPLOADS_PATH=./uploads
LOGS_PATH=./logs

PORT_RANGE_START=4000
PORT_RANGE_END=5000
MAX_FILE_SIZE_MB=200
HEALTH_CHECK_RETRIES=10
HEALTH_CHECK_INTERVAL_MS=3000
HEALTH_CHECK_TIMEOUT_MS=30000
PROCESS_START_WAIT_MS=5000
