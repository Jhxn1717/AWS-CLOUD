PORT=3001
NODE_ENV=development

# PostgreSQL Administrative DB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mycloud_platform
DB_USER=mycloud_admin
DB_PASSWORD=

# Initial administrator account (required by db:seed)
ADMIN_NAME=MyCloud Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-random-password-at-least-12-characters

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Paths
PROJECTS_BASE_PATH=./projects
UPLOADS_PATH=./uploads
LOGS_PATH=./logs

# Port pool for deployed projects
PORT_RANGE_START=4000
PORT_RANGE_END=5000

# Upload limits
MAX_FILE_SIZE_MB=200
